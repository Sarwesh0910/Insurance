pipeline {
    agent any

    environment {
        IMAGE_NAME = "insurance-platform"
        DOCKER_REGISTRY = "docker.io"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'docker-compose build'
            }
        }

        stage('Security Scan') {
            steps {
                sh 'echo "Running Security Scans"'
            }
        }

        stage('Push Images') {
            steps {
                sh 'echo "Push Docker Images"'
            }
        }

        stage('Deploy') {
            steps {
                sh 'kubectl apply -f kubernetes/'
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful'
        }

        failure {
            echo 'Deployment Failed'
        }
    }
}
